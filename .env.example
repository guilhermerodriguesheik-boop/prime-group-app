# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API oficial OpenAI - apenas no servidor (nunca prefixar com NEXT_PUBLIC_)
OPENAI_API_KEY=
# Roteamento automatico de custo do assistente web e WhatsApp.
# Modelos abaixo sao opcionais: os padroes ja economizam sem variaveis configuradas.
PRIME_AI_ECONOMY_MODEL=gpt-6-luna
PRIME_AI_COMPLEX_MODEL=gpt-6.1-sol
# Opcional: usar modelo especifico em fotos e PDF (padrao = complexo).
PRIME_AI_VISION_MODEL=
# Variaveis antigas abaixo nao sao usadas pelo novo roteador: nao as habilite.
# PRIME_AGENT_MODEL=
# PRIME_VISION_MODEL=
# Opcional: modelo de transcrição de voz. Padrão: gpt-4o-mini-transcribe.
PRIME_TRANSCRIPTION_MODEL=

# Legacy (somente se houver outras rotas dependentes do Vercel AI Gateway)
AI_GATEWAY_MODEL=
AI_GATEWAY_API_KEY=

# WhatsApp provider: "meta" (official) or "evolution" (QR / unofficial).
# No provider is activated until all credentials and webhook are configured.
# Open Finance read-only provider credentials, never NEXT_PUBLIC_.
# Before enabling verify Pluggy commercial terms (PJ) or Meu Pluggy personal limits.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Optional, one-owner-only bridge for a personal Meu Pluggy item without clientUserId
PLUGGY_PERSONAL_OWNER_ID=

WHATSAPP_PROVIDER=meta
# What's Evolution Go (provider=evolution_go; HTTPS-only, server-side only).
# Provider emits instanceToken in webhook JSON. Do not put tokens in URL or repository.
EVOLUTION_GO_API_URL=
EVOLUTION_GO_TOKEN=
EVOLUTION_GO_INSTANCE_NAME=
EVOLUTION_GO_PHONE_NUMBER=
# Evolution API v2 (only required when WHATSAPP_PROVIDER=evolution).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Unique random secret with >=32 characters; configure as custom webhook header
# "x-prime-webhook-secret" on the Evolution instance. Never NEXT_PUBLIC_.
EVOLUTION_WEBHOOK_SECRET=
# Optional public display for the connected QR channel; digits only, DDI+DDD+number
EVOLUTION_PHONE_NUMBER=

# WhatsApp Cloud API (somente servidor)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_INGRESS_SECRET=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=
WHATSAPP_GRAPH_VERSION=v24.0
WHATSAPP_DAILY_LIMIT=60

# Open Finance / Pluggy
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Google Gmail OAuth (somente leitura, conta lgtransporteelogistica@gmail.com)
# Configurar redirect URL Google: https://seu-dominio/api/fiscal/gmail/callback
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
# openssl rand -hex 32 (apenas servidor; NUNCA versionar valor real)
GMAIL_TOKEN_ENCRYPTION_KEY=

# Cargozilla
CARGOZILLA_API_BASE_URL=
CARGOZILLA_API_TOKEN=

# App
NEXT_PUBLIC_APP_NAME=Prime Finance
APP_BASE_URL=http://localhost:3000
CRON_SECRET=
WHATSAPP_GRAPH_VERSION=
